
# =============================================================================
# CONFIGURACION CENTRAL — pdfinfraestructure
# Copiar este archivo a .env en esta carpeta.
# Reemplazar las credenciales de ejemplo antes de utilizarlo.
# No subir el archivo .env real al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB — administrador
# Exclusivamente para inicializacion y administracion de MongoDB.
# No utilizar estas credenciales desde los microservicios.
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=CAMBIAR_USUARIO_ROOT
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT
MONGO_PORT=27018

# -----------------------------------------------------------------------------
# MongoDB — usuario de aplicacion (pdf_ms3_app)
# Permisos: readWrite sobre pdf_database_dev.
# -----------------------------------------------------------------------------

# MS3 ejecutado localmente.
MONGO_URL=mongodb://pdf_ms3_app:CAMBIAR_PASSWORD_APP@localhost:27018/pdf_database_dev?authSource=pdf_database_dev

# MS3 ejecutado dentro de Docker Compose.
MONGO_URL_DOCKER=mongodb://pdf_ms3_app:CAMBIAR_PASSWORD_APP@db:27017/pdf_database_dev?authSource=pdf_database_dev

# -----------------------------------------------------------------------------
# MongoDB — usuario de testing (pdf_ms3_test)
# Permisos: readWrite sobre pdf_database_test.
# -----------------------------------------------------------------------------

# Tests ejecutados localmente.
MONGO_TEST_URL=mongodb://pdf_ms3_test:CAMBIAR_PASSWORD_TEST@localhost:27018/pdf_database_test?authSource=pdf_database_test

# Tests ejecutados dentro de Docker Compose.
MONGO_TEST_URL_DOCKER=mongodb://pdf_ms3_test:CAMBIAR_PASSWORD_TEST@db:27017/pdf_database_test?authSource=pdf_database_test

# -----------------------------------------------------------------------------
# Configuracion de bases y colecciones
# -----------------------------------------------------------------------------
MONGO_DB_DEV=pdf_database_dev
MONGO_COLLECTION=processed_pdfs

# -----------------------------------------------------------------------------
# Procesamiento de PDF
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=5

# Maximo de extracciones admitidas por replica de MS2
MAX_ADMITTED_EXTRACTIONS=2

# -----------------------------------------------------------------------------
# Direcciones para ejecuciones locales independientes
# -----------------------------------------------------------------------------
MS3_URL=http://localhost:8001
EXTRACT_SERVICE_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# Direcciones internas del Compose integrado
# -----------------------------------------------------------------------------
MS3_URL_DOCKER=http://crud-service:8000
EXTRACT_SERVICE_URL_DOCKER=http://traefik-internal:8080

# -----------------------------------------------------------------------------
# Direccion de MS2 para el Compose individual de MS3
# -----------------------------------------------------------------------------
EXTRACT_SERVICE_URL_SINGLE_DOCKER=http://host.docker.internal:8000

# -----------------------------------------------------------------------------
# Puertos y timeouts
# -----------------------------------------------------------------------------
TRAEFIK_PUBLIC_HOST_PORT=8080
EXTRACT_SERVICE_TIMEOUT=30
MS3_TIMEOUT=40

# Solo para publicar MS3 en el host con pdfcrudservice/docker-compose.single.yml.
APP_PORT=8001

# Solo para publicar MS2 en el host con pdfextractext/docker-compose.single.yml.
MS2_HOST_PORT=8000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
