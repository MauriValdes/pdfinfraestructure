# =================================================================
# .env.example — Integracion MS1 + MS2 + MS3 + MongoDB
# Valores de ejemplo para ejecutar localmente.
# Copiar a .env y ajustar los valores segun el entorno.
# Este archivo NO contiene credenciales reales.
# =================================================================

# --- Credenciales MongoDB (desarrollo local; reemplazar en .env) ---
MONGO_INITDB_ROOT_USERNAME=usuario
MONGO_INITDB_ROOT_PASSWORD=contraseña

# --- Puerto host para acceso de inspeccion con mongosh ---
MONGO_PORT=27017

# --- Base de datos y coleccion utilizadas por MS3 ---
MONGO_DB_DEV=pdf_database_dev
MONGO_COLLECTION=processed_pdfs

# --- Tamano maximo permitido para archivos PDF (MB) ---
MAX_FILE_SIZE_MB=5

# --- Comunicacion entre servicios (nombres internos de Docker) ---
EXTRACT_SERVICE_URL=http://extract-service:8000
EXTRACT_SERVICE_TIMEOUT=30
MS3_URL=http://crud-service:8000
MS3_TIMEOUT=40

# --- Puertos internos y publicados ---
APP_PORT=8000
HOST_PORT_GATEWAY=8003
LOG_LEVEL=INFO
