# Copiar a .env en esta carpeta. Este archivo contiene solo ejemplos.
# Reemplazar las credenciales antes de usarlo fuera de pruebas locales.

# MongoDB: la aplicación ejecutada localmente usa MONGO_URL (localhost).
# Compose crea la URL interna hacia db:27017 usando usuario y contraseña.
MONGO_INITDB_ROOT_USERNAME=CAMBIAR_USUARIO
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_PASSWORD
MONGO_PORT=27018
MONGO_URL=mongodb://CAMBIAR_USUARIO:CAMBIAR_PASSWORD@localhost:27018/?authSource=admin
# Opcional: URI interna personalizada (las credenciales deben estar URL-encoded).
# MONGO_URL_DOCKER=mongodb://USUARIO:PASSWORD@db:27017/?authSource=admin

MONGO_DB_DEV=pdf_database_dev
MONGO_COLLECTION=processed_pdfs
MAX_FILE_SIZE_MB=5

# Direcciones para ejecuciones locales independientes (no son puertos publicados
# por el Compose integrado centralizado).
MS3_URL=http://localhost:8001
EXTRACT_SERVICE_URL=http://localhost:8002

# Direcciones internas del Compose integrado; Compose las inyecta en los servicios.
MS3_URL_DOCKER=http://crud-service:8000
EXTRACT_SERVICE_URL_DOCKER=http://traefik-internal:8080
# El Compose individual de MS3 no incluye MS2: se conecta a un MS2 del host.
EXTRACT_SERVICE_URL_SINGLE_DOCKER=http://host.docker.internal:8000

TRAEFIK_PUBLIC_HOST_PORT=8080
EXTRACT_SERVICE_TIMEOUT=30
MS3_TIMEOUT=40
# Solo para publicar MS3 en el host con pdfcrudservice/docker-compose.single.yml.
APP_PORT=8001
# Solo para publicar MS2 en el host con pdfextractext/docker-compose.single.yml.
MS2_HOST_PORT=8000
LOG_LEVEL=INFO
